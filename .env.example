# Supabase project URL, found in Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# Publishable/anon key; safe for browser use when RLS is enabled
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Secret/service-role key. SERVER ONLY: never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SECRET_KEY
# Temporary long random bootstrap secret used only during the Admin Auth transition.
# Remove server-side support after the initial Auth administrator is provisioned and verified.
ADMIN_SETUP_SECRET=YOUR_TEMPORARY_BOOTSTRAP_SECRET
# Server-only HMAC secret used for durable guest join rate-limit keys.
RATE_LIMIT_HASH_SECRET=YOUR_SERVER_ONLY_RATE_LIMIT_SECRET
# Public site URL; local development default shown
NEXT_PUBLIC_SITE_URL=http://localhost:3000
